# NoteFlow Desktop — copy this file to `.env` and fill with your Supabase keys.
# (Same values you used for the web app / Vercel.)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Base URL of the deployed web app, used by "Edit in web" links in widgets.
VITE_APP_BASE_URL=https://itsmynote.vercel.app
