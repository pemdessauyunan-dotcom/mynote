{
  "name": "noteflow",
  "private": true,
  "version": "0.1.0",
  "description": "NoteFlow - real-time personal notes with desktop widgets (web + PWA + Tauri desktop).",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:web": "pnpm --filter @noteflow/web dev",
    "dev:desktop": "pnpm --filter @noteflow/desktop tauri dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @noteflow/web build",
    "build:desktop": "pnpm --filter @noteflow/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @noteflow/web test:unit",
    "test:e2e": "pnpm --filter @noteflow/web test:e2e",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
