# =============================================================
# NoteFlow environment template
# Copy to .env (and apps/web/.env.local, apps/desktop/.env.local)
# NEVER commit real keys. NEVER put service_role key in any
# frontend, PWA, or desktop binary.
# =============================================================

# Supabase project (anon key is safe for browsers/desktop; RLS enforces access)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: override PWA / web app base URL (e.g. for custom domain)
VITE_APP_BASE_URL=http://localhost:5173

# Desktop (Tauri) uses the same two VITE_ vars above via env at build time.
# Do NOT put SUPABASE_SERVICE_ROLE_KEY here; only use it in server-side
# migration/seed scripts if absolutely required.
SUPABASE_SERVICE_ROLE_KEY=
